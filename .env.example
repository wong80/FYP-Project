# Copy to .env (git-ignored) and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=change-me-three

# Optional: live ESP32 feed from Firebase RTDB.
# FIREBASE_DB_URL=https://<project>-default-rtdb.<region>.firebasedatabase.app
# FIREBASE_UID=<uid of the ESP32's Firebase user>
# FIREBASE_SA_FILE=./deploy/firebase-service-account.json   # service-account key, git-ignored
