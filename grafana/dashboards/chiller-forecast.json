{
  "uid": "chiller-forecast",
  "title": "Chiller power forecast",
  "tags": [
    "chiller",
    "forecast"
  ],
  "timezone": "Asia/Kuala_Lumpur",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now+2h"
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescale"
        },
        "query": "SELECT DISTINCT source FROM readings ORDER BY 1",
        "definition": "SELECT DISTINCT source FROM readings ORDER BY 1",
        "current": {
          "text": "building_meter",
          "value": "building_meter"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Model promoted",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescale"
        },
        "enable": true,
        "iconColor": "#9085e9",
        "target": {
          "refId": "Anno",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code",
          "rawSql": "SELECT created_at AS time, 'Promoted v' || model_version AS text FROM model_events WHERE event = 'promoted' AND $__timeFilter(created_at)"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Next-hour forecast",
      "description": "Forecast for the coming hour from the live model (or the seasonal-naive fallback when data is stale).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT predicted_kw FROM forecasts WHERE source = '$source' AND role IN ('champion','fallback') AND target_ts > now() ORDER BY target_ts LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latest reading",
      "description": "Age of the newest clean reading. Amber after 2 h, red after 6 h: forecasts switch to the seasonal-naive fallback (M4).",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT EXTRACT(EPOCH FROM now() - max(ts)) AS age FROM readings WHERE source = '$source'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 7200
              },
              {
                "color": "#d03b3b",
                "value": 21600
              }
            ]
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "MAE in range",
      "description": "Mean absolute error of the shown forecasts over the selected time range.",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(abs(error_kw)) FROM actual_vs_forecast WHERE source = '$source' AND actual_kw IS NOT NULL AND $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Live model",
      "description": "Model version currently promoted to champion (MLflow alias).",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 'v' || model_version AS version FROM model_events WHERE event = 'promoted' ORDER BY created_at DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^version$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Quarantined, last 24 h",
      "description": "Readings rejected by the data guardrails in the last day. Amber from 1, red from 5 (M5).",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM quarantine WHERE source = '$source' AND created_at > now() - interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 5
              }
            ]
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Chiller power: actual vs forecast (kW)",
      "description": "Measured total active power next to the one-hour-ahead forecast. Gaps are missing or quarantined hours and are never filled in.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, \"activePowerT\" AS \"Actual\" FROM readings WHERE source = '$source' AND $__timeFilter(ts) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT target_ts AS time, predicted_kw AS \"Forecast\" FROM forecasts WHERE source = '$source' AND role IN ('champion','replay') AND $__timeFilter(target_ts) ORDER BY 1"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT target_ts AS time, predicted_kw AS \"Fallback (same hour last week)\" FROM forecasts WHERE source = '$source' AND role = 'fallback' AND $__timeFilter(target_ts) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "gradientMode": "none"
          },
          "unit": "kwatt",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Actual"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Forecast"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fallback (same hour last week)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Forecast error, rolling 24 h MAE (kW)",
      "description": "How far off the shown forecasts have been over the previous 24 hours (M1). A rising line means the model is drifting.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, avg(abs(error_kw)) OVER (ORDER BY ts RANGE BETWEEN interval '23 hours' PRECEDING AND CURRENT ROW) AS \"Rolling 24 h MAE\" FROM actual_vs_forecast WHERE source = '$source' AND actual_kw IS NOT NULL AND $__timeFilter(ts) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "gradientMode": "none"
          },
          "unit": "kwatt",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Rolling 24 h MAE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Model events",
      "description": "Training runs, gate decisions and promotions. Full detail lives in MLflow.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT created_at AS \"Time\", event AS \"Event\", 'v' || model_version AS \"Version\", coalesce(detail->>'reason', round((detail->'metrics'->>'mae')::numeric, 2)::text || ' kW holdout MAE') AS \"Detail\" FROM model_events ORDER BY created_at DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Ingest runs",
      "description": "Each ingest job: rows received, stored and quarantined, and missing hours.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT started_at AS \"Time\", source AS \"Source\", status AS \"Status\", rows_new AS \"New\", rows_clean AS \"Clean\", rows_quarantined AS \"Quarantined\", gap_hours AS \"Gap h\" FROM ingest_runs ORDER BY started_at DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}